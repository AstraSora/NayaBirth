rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Birth plans are NOT stored in the cloud (IRB protocol: no PHI persisted
    // server-side, no PIN-based retrieval). The app writes no Firestore data.
    // Deny all access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
